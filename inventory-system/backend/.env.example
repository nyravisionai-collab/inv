PORT=5000
HOST=0.0.0.0
# Keep enabled for local computer + LAN/private-network devices only.
LAN_ONLY=1
DB_PATH=./data/inventory.db
UPLOAD_DIR=./uploads
BACKUP_DIR=./backups
NODE_ENV=production
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=2000
BCRYPT_ROUNDS=10
CORS_ORIGIN=*
# Set to 1 only when running behind a reverse proxy (nginx, Caddy, Cloudflare).
# Leaving this at 0 prevents clients from spoofing their IP via X-Forwarded-For.
TRUST_PROXY=0
# Serve the built frontend from the backend port (single-port deployment).
SERVE_FRONTEND=0
# Serve over HTTPS using the self-signed cert from scripts/generate-cert.sh.
# Required for phones on the LAN to install the PWA — service workers only
# run in a secure context (https://, or http://localhost). Run
# "bash scripts/generate-cert.sh" once (and again if the LAN IP changes)
# before enabling this.
HTTPS=0
COMPANY_NAME=My Business
CURRENCY=INR
CURRENCY_SYMBOL=₹
TIMEZONE=Asia/Kolkata
